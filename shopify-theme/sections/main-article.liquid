<article class="article section-spacing page-width page--narrow">
  <header class="article__header">
    <time class="blog__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
      {{ article.published_at | date: '%Y.%m.%d' }}
    </time>
    <h1 class="article__title">{{ article.title }}</h1>
  </header>

  {%- if article.image -%}
    <div class="article__image">
      <img
        src="{{ article.image | image_url: width: 1400 }}"
        alt="{{ article.title | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
      >
    </div>
  {%- endif -%}

  <div class="rte">
    {{ article.content }}
  </div>

  <div class="article__back">
    <a href="{{ blog.url }}" class="button button--secondary">{{ 'blogs.article.back_to_blog' | t }}</a>
  </div>
</article>

{% schema %}
{
  "name": "記事",
  "settings": []
}
{% endschema %}
