{%- if section.blocks.size > 0 -%}
  <div
    class="slideshow slideshow--{{ section.settings.height }}"
    data-slideshow
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
  >
    <div class="slideshow__track">
      {%- for block in section.blocks -%}
        <div class="slideshow__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              class="slideshow__image"
              srcset="{{ block.settings.image | image_url: width: 960 }} 960w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2400 }} 2400w"
              sizes="100vw"
              src="{{ block.settings.image | image_url: width: 1600 }}"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image placeholder-svg' }}
          {%- endif -%}
          <div class="slideshow__content slideshow__content--{{ block.settings.position }}">
            {%- if block.settings.subheading != blank -%}
              <p class="slideshow__subheading">{{ block.settings.subheading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="slideshow__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button button--primary slideshow__button">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button
            class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
            data-slide-to="{{ forloop.index0 }}"
            aria-label="{{ 'sections.slideshow.slide' | t: number: forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "スライドショー",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "高さ",
      "options": [
        { "value": "small", "label": "小" },
        { "value": "medium", "label": "中" },
        { "value": "large", "label": "大" }
      ],
      "default": "large"
    },
    { "type": "checkbox", "id": "autoplay", "label": "自動再生", "default": true },
    { "type": "range", "id": "interval", "label": "切替間隔", "min": 3, "max": 9, "step": 1, "unit": "秒", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "スライド",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "subheading", "label": "サブ見出し", "default": "NEW COLLECTION" },
        { "type": "text", "id": "heading", "label": "見出し", "default": "2026 SPRING / SUMMER" },
        { "type": "text", "id": "button_label", "label": "ボタンラベル", "default": "SHOP NOW" },
        { "type": "url", "id": "button_link", "label": "ボタンリンク" },
        {
          "type": "select",
          "id": "position",
          "label": "テキスト位置",
          "options": [
            { "value": "left", "label": "左" },
            { "value": "center", "label": "中央" },
            { "value": "right", "label": "右" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    { "name": "スライドショー", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ]
}
{% endschema %}
