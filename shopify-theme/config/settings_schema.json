[
  {
    "name": "theme_info",
    "theme_name": "Brillante",
    "theme_version": "1.0.0",
    "theme_author": "Popaism",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://shopify.dev/docs/storefronts/themes"
  },
  {
    "name": "カラー",
    "settings": [
      { "type": "color", "id": "color_text", "label": "テキスト", "default": "#000000" },
      { "type": "color", "id": "color_heading", "label": "見出し", "default": "#282828" },
      { "type": "color", "id": "color_background", "label": "背景", "default": "#ffffff" },
      { "type": "color", "id": "color_background_secondary", "label": "サブ背景", "default": "#f5f5f5" },
      { "type": "color", "id": "color_border", "label": "ボーダー", "default": "#d9d9d9" },
      { "type": "color", "id": "color_accent", "label": "アクセント", "default": "#282828" },
      { "type": "color", "id": "color_sale", "label": "セール価格", "default": "#de2a2a" },
      { "type": "color", "id": "color_sold_out", "label": "SOLD OUT表示", "default": "#6f719b" },
      { "type": "color", "id": "color_button_background", "label": "ボタン背景", "default": "#282828" },
      { "type": "color", "id": "color_button_text", "label": "ボタンテキスト", "default": "#ffffff" }
    ]
  },
  {
    "name": "タイポグラフィ",
    "settings": [
      { "type": "font_picker", "id": "heading_font", "label": "見出しフォント", "default": "assistant_n8" },
      { "type": "font_picker", "id": "body_font", "label": "本文フォント", "default": "assistant_n4" },
      { "type": "checkbox", "id": "heading_uppercase", "label": "見出しを大文字にする", "default": true }
    ]
  },
  {
    "name": "レイアウト",
    "settings": [
      { "type": "range", "id": "page_width", "label": "ページ最大幅", "min": 1000, "max": 1600, "step": 100, "unit": "px", "default": 1400 },
      { "type": "range", "id": "button_radius", "label": "ボタンの角丸", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 24 }
    ]
  },
  {
    "name": "商品カード",
    "settings": [
      { "type": "checkbox", "id": "card_show_vendor", "label": "ブランド名を表示", "default": true },
      { "type": "checkbox", "id": "card_hover_image", "label": "ホバーで2枚目の画像を表示", "default": true },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "画像の縦横比",
        "options": [
          { "value": "square", "label": "正方形" },
          { "value": "portrait", "label": "縦長 (3:4)" },
          { "value": "natural", "label": "元画像のまま" }
        ],
        "default": "portrait"
      }
    ]
  },
  {
    "name": "SNS",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_line", "label": "LINE URL" },
      { "type": "text", "id": "social_twitter", "label": "X (Twitter) URL" }
    ]
  },
  {
    "name": "ファビコン",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "ファビコン画像", "info": "32×32px推奨" }
    ]
  }
]
